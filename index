    const button = event.target.closest('[data-action]'); if (!button) return; const card = cards.find(item => item.id === button.dataset.id); if (!card) return;
    if (button.dataset.action === 'edit') fillCardForm(card);
    if (button.dataset.action === 'toggle') { card.visible = !card.visible; saveCards(); renderCards(); renderRoster(); }
    if (button.dataset.action === 'delete' && !card.protected && confirm(`Remove “${card.name}” permanently?`)) { cards = cards.filter(item => item.id !== card.id); saveCards(); renderCards(); renderRoster(); clearCardForm(); }
  });
  $('#cardImage').addEventListener('change', event => {
    const file = event.target.files[0]; if (!file) return; if (file.size > 2.5 * 1024 * 1024) { event.target.value=''; notify('Choose an image smaller than 2.5 MB'); return; }
    const reader = new FileReader(); reader.onload = () => { pendingImage = String(reader.result); notify('Background image ready'); }; reader.readAsDataURL(file);
  });
  $('#cardForm').addEventListener('submit', event => {
    event.preventDefault(); const id = $('#cardId').value; const existing = cards.find(card => card.id === id); const protectedBase = existing && locked[id];
    const submittedURL = cleanURL($('#cardUrl').value); if (!protectedBase && !submittedURL) { notify('Enter a valid HTTP or HTTPS URL'); return; }
    const raw = { id:id || `custom-${Date.now()}`, name:$('#cardName').value, mark:$('#cardMark').value, url:protectedBase?protectedBase.url:submittedURL, username:$('#cardUsername').value, domain:protectedBase?protectedBase.domain:$('#cardDomain').value, subtitle:$('#cardSubtitle').value, description:$('#cardDescription').value, overlay:$('#cardOverlay').checked, visible:$('#cardVisible').checked, background:pendingImage, theme:existing?.theme || 'default' };
    const saved = cleanCard(raw); if (!saved.username || !saved.domain) { notify('Email username and domain are required'); return; }
    if (existing) cards[cards.indexOf(existing)] = saved; else cards.push(saved); saveCards(); renderCards(); renderRoster(); fillCardForm(saved); notify('Carousel card saved');
  });

  /* Import/sync status */
  $('#importConfigBtn').addEventListener('click', () => $('#importConfigInput').click());
  $('#importConfigInput').addEventListener('change', async event => {
    const file = event.target.files[0]; if (!file) return;
    try {
      const payload = JSON.parse(await file.text()); if (!Array.isArray(payload.cards)) throw new Error('Missing cards'); cards = normaliseCards(payload.cards); localStorage.setItem(STORAGE.cards, JSON.stringify(cards));
      if (Array.isArray(payload.reference)) { localStorage.setItem(STORAGE.refs, JSON.stringify(payload.reference.slice(0,6))); loadReferences(); }
      if (payload.clock && typeof payload.clock === 'object') { clockConfig = Object.assign(clockConfig, payload.clock); localStorage.setItem(STORAGE.clock, JSON.stringify(clockConfig)); applyClockConfig(); }
      if (Array.isArray(payload.referenceHistory)) { referenceHistory = payload.referenceHistory.slice(0,5); localStorage.setItem(STORAGE.history, JSON.stringify(referenceHistory)); renderHistory(); }
      renderCards(); setSync('green','Recently synced'); notify('Workspace imported');
    } catch { setSync('red','Import error'); notify('That backup file could not be imported'); }
    event.target.value = '';
  });

  /* Editable reference sequence with undo and five-entry history */
  let referenceValues = readJSON(STORAGE.refs, ['3200','4837','4959','7073','8522','5482']);
  let referenceHistory = readJSON(STORAGE.history, []);

  $('#exportConfigBtn').addEventListener('click', () => {
    const backup = {version:1,exportedAt:new Date().toISOString(),cards,reference:referenceValues,referenceHistory,clock:clockConfig};
    const blob = new Blob([JSON.stringify(backup,null,2)], {type:'application/json'});
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a'); link.href = url; link.download = 'agent-launchpad-backup.json'; link.click();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
    notify('Workspace backup downloaded');
  });

  function loadReferences() { referenceValues = readJSON(STORAGE.refs, referenceValues); $$('#referenceGrid code').forEach((cell,index) => cell.textContent = referenceValues[index] ?? ''); renderHistory(); }
  function renderHistory() { $('#historyPanel').innerHTML = referenceHistory.length ? referenceHistory.map(entry => `<div class="history-item"><time>${escapeHTML(new Date(entry.timestamp).toLocaleString())}</time><code>${escapeHTML(entry.previous.join(' · '))}</code></div>`).join('') : '<p>No saved changes yet.</p>'; }
  function showSaveFlash() { const flash = $('#saveFlash'); flash.classList.add('show'); clearTimeout(flashTimer); flashTimer = setTimeout(() => flash.classList.remove('show'), 5200); }
  $$('#referenceGrid code').forEach(cell => cell.addEventListener('blur', () => {
    const next = $$('#referenceGrid code').map(item => item.textContent.trim().slice(0,48)); if (JSON.stringify(next) === JSON.stringify(referenceValues)) return;
    referenceHistory.unshift({timestamp:new Date().toISOString(),previous:[...referenceValues]}); referenceHistory = referenceHistory.slice(0,5); referenceValues = next; localStorage.setItem(STORAGE.refs,JSON.stringify(referenceValues)); localStorage.setItem(STORAGE.history,JSON.stringify(referenceHistory)); renderHistory(); showSaveFlash(); markChanged();
  }));
  $('#undoReference').addEventListener('click', () => { const last = referenceHistory.shift(); if (!last) return; referenceValues = last.previous; localStorage.setItem(STORAGE.refs,JSON.stringify(referenceValues)); localStorage.setItem(STORAGE.history,JSON.stringify(referenceHistory)); loadReferences(); $('#saveFlash').classList.remove('show'); notify('Last reference change undone'); markChanged(); });
  $('#historyToggle').addEventListener('click', event => { event.preventDefault(); event.stopPropagation(); $('#historyPanel').classList.toggle('open'); });
  $('#copyReferenceBtn').addEventListener('click', async event => {
    event.preventDefault(); event.stopPropagation();
    try { await copyText(referenceValues.join(' · ')); notify('Reference sequence copied'); } catch { notify('Clipboard permission was unavailable'); }
  });
  loadReferences();
})();

  
  </script>
  <script>
    // 1. Agent Profiles Directory
    const AGENT_PROFILES = {
      amir: {
        name: 'Amir Faaiz',
        google: 'shamsmuhammadam@support.fb.com',
        microsoft: 'shamsolnizam.5@apac.teleperformance.com',
        icewarp: 'amirfaaiz.shamsolnizam@fb.teleperformance-my.com',
        meta: 'faaiz@outlook.my'
      },
      yoca: {
        name: 'Yoca Alfarizi',
        google: 'alfaryoca@support.fb.com',
        microsoft: 'alfarizi.6@apac.teleperformance.com',
        icewarp: 'yoca.alfarizi@fb.teleperformance-my.com',
        meta: 'alfaryoca@support.fb.com'
      },
      custom: {
        name: 'Colleague Custom',
        google: '',
        microsoft: '',
        icewarp: '',
        meta: ''
      }
    };

    let currentProfileKey = 'amir';

    // Build Dynamic Pre-Fill Login URLs
    function buildPortalUrl(portalType, profile) {
      const gEmail = encodeURIComponent(profile.google || '');
      const msEmail = encodeURIComponent(profile.microsoft || '');
      const iceEmail = encodeURIComponent(profile.icewarp || '');

      switch (portalType) {
        case 'google':
          return `https://accounts.google.com/AccountChooser?Email=${gEmail}&continue=https://www.google.com`;
        case 'learn':
          return `https://teleperformance-mytp.sabacloud.com/?login_hint=${msEmail}`;
        case 'bms':
          return `https://www.seadc.ccms.teleperformance.com/?login_hint=${msEmail}`;
        case 'icewarp':
          return `https://tp.onice.io/webmail/?username=${iceEmail}&email=${iceEmail}`;
        case 'meta':
          return `https://outlook.my/`;
        default:
          return 'https://www.google.com';
      }
    }

    function getPortalEmail(portalType, profile) {
      switch (portalType) {
        case 'google': return profile.google;
        case 'learn': return profile.microsoft;
        case 'bms': return profile.microsoft;
        case 'icewarp': return profile.icewarp;
        case 'meta': return profile.meta || profile.google;
        default: return profile.google;
      }
    }

    const statusMessage = document.getElementById('statusMessage');
    function setStatus(text) {
      statusMessage.textContent = text;
    }

    async function copyText(value) {
      if (!value) return;
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(value);
        return;
      }
      const helper = Object.assign(document.createElement('textarea'), { value });
      helper.style.position = 'fixed';
      helper.style.opacity = '0';
      document.body.appendChild(helper);
      helper.select();
      document.execCommand('copy');
      helper.remove();
    }

    function applyProfile(profileKey, updateUrl = true) {
      if (!AGENT_PROFILES[profileKey]) profileKey = 'amir';
      currentProfileKey = profileKey;
      const profile = AGENT_PROFILES[profileKey];

      // Toggle active button state
      document.querySelectorAll('.profile-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.profile === profileKey);
      });

      // Toggle custom drawer
      const drawer = document.getElementById('customDrawer');
      drawer.classList.toggle('open', profileKey === 'custom');

      // Update matrix owner name
      document.getElementById('matrixOwner').textContent = profile.name;

      // The current profile is applied to the managed carousel without changing saved card records.
      window.AgentAtlas?.setProfile(profileKey, profile);

      if (updateUrl) {
        const url = new URL(window.location.href);
        url.searchParams.set('u', profileKey);
        window.history.replaceState({}, '', url);
      }

      setStatus(`Active Profile: ${profile.name} — Click any card to auto-copy its email & launch portal.`);
    }

    // Read URL query parameters on load (?u=yoca or ?u=amir)
    const params = new URLSearchParams(window.location.search);
    const initialUser = (params.get('u') || '').toLowerCase();
    if (initialUser === 'yoca' || initialUser === 'alfaryoca') {
      applyProfile('yoca', false);
    } else if (initialUser === 'custom') {
      AGENT_PROFILES.custom.google = params.get('g') || '';
      AGENT_PROFILES.custom.microsoft = params.get('ms') || '';
      AGENT_PROFILES.custom.icewarp = params.get('ice') || '';
      document.getElementById('custGoogle').value = AGENT_PROFILES.custom.google;
      document.getElementById('custMs').value = AGENT_PROFILES.custom.microsoft;
      document.getElementById('custIce').value = AGENT_PROFILES.custom.icewarp;
      applyProfile('custom', false);
    } else {
      applyProfile('amir', false);
    }

    // Profile Switcher Listeners
    document.querySelectorAll('.profile-btn').forEach(btn => {
      btn.addEventListener('click', () => applyProfile(btn.dataset.profile));
    });

    // Custom Colleague Input Listeners
    ['custGoogle', 'custMs', 'custIce'].forEach(id => {
      document.getElementById(id).addEventListener('input', () => {
        AGENT_PROFILES.custom.google = document.getElementById('custGoogle').value.trim();
        AGENT_PROFILES.custom.microsoft = document.getElementById('custMs').value.trim();
        AGENT_PROFILES.custom.icewarp = document.getElementById('custIce').value.trim();
        AGENT_PROFILES.custom.meta = AGENT_PROFILES.custom.google;
        applyProfile('custom', false);
      });
    });

    // Quick Copy Matrix Pills
    document.querySelectorAll('.quick-copy-pill').forEach(btn => {
      btn.addEventListener('click', async () => {
        const key = btn.dataset.key;
        const email = AGENT_PROFILES[currentProfileKey][key];
        if (!email) return setStatus('Please fill in the custom email field first.');
        await copyText(email);
        setStatus(`Copied ${email} to clipboard! Ready for Ctrl+V.`);
      });
    });

    // Launch All Shift Tabs Button
    document.getElementById('openAllShiftBtn').addEventListener('click', async () => {
      const profile = AGENT_PROFILES[currentProfileKey];
      const urls = window.AgentAtlas?.coreUrls() || ['google','learn','bms','icewarp'].map(p => buildPortalUrl(p,profile));
      const tabs = urls.map(() => window.open('about:blank','_blank'));
      const googleEmail = window.AgentAtlas?.getEmailByKey('google') ?? profile.google;
      try { if (googleEmail) await copyText(googleEmail); } catch {}
      urls.forEach((url, i) => { if (tabs[i]) {tabs[i].opener=null; tabs[i].location.replace(url);} });
      setStatus(`Opened ${tabs.filter(Boolean).length}/${urls.length} core shift portals. ${googleEmail ? 'Google email copied when permitted.' : 'Enter a Google email to enable copying.'}`);
    });

    // Native Browser Screen Capture (Replaces SnippingTool.exe Ctrl+N mistake)
    const videoEl = document.getElementById('captureVideo');
    const canvasEl = document.getElementById('captureCanvas');
    const connectBtn = document.getElementById('connectScreenBtn');

    async function startScreenStream() {
      try {
        const stream = await navigator.mediaDevices.getDisplayMedia({
          video: { cursor: 'always' },
          audio: false
        });
        videoEl.srcObject = stream;
        connectBtn.classList.add('snap-ready');
        connectBtn.textContent = 'Screen Connected ✓';
        setStatus('Screen stream active! Press Spacebar or click "2. Snap to Clipboard" anytime.');
        stream.getVideoTracks()[0].addEventListener('ended', () => {
          connectBtn.classList.remove('snap-ready');
          connectBtn.textContent = '1. Connect Screen Capture';
          setStatus('Screen stream ended.');
        });
      } catch (err) {
        setStatus('Screen capture cancelled or blocked: ' + err.message);
      }
    }

    async function snapFrameToClipboard() {
      if (!videoEl.srcObject) {
        await startScreenStream();
        return;
      }
      canvasEl.width = videoEl.videoWidth;
      canvasEl.height = videoEl.videoHeight;
      const ctx = canvasEl.getContext('2d');
      ctx.drawImage(videoEl, 0, 0);
      canvasEl.toBlob(async (blob) => {
        try {
          await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
          setStatus(`Screenshot copied to clipboard at ${new Date().toLocaleTimeString()}! Press Ctrl+V anywhere.`);
        } catch (err) {
          setStatus('Clipboard write failed: ' + err.message);
        }
      }, 'image/png');
    }

    connectBtn.addEventListener('click', startScreenStream);
    document.getElementById('snapClipBtn').addEventListener('click', snapFrameToClipboard);

    // Spacebar Hotkey when on Launchpad tab (when not typing in an input)
    window.addEventListener('keydown', (e) => {
      const tag = document.activeElement ? document.activeElement.tagName : '';
      if (e.code === 'Space' && !['INPUT','TEXTAREA','SELECT','BUTTON'].includes(tag) && !document.activeElement?.isContentEditable && !document.activeElement?.closest('.site-card, .clock-settings, .code-vault, .manager-modal') && videoEl.srcObject) {
        e.preventDefault();
        snapFrameToClipboard();
      }
    });

    // Download .URL Internet Shortcut to SnippingTool.exe
    document.getElementById('dlSnipUrlBtn').addEventListener('click', () => {
      const content = `[InternetShortcut]
URL=file:///C:/Windows/System32/SnippingTool.exe
IconFile=C:\Windows\System32\SnippingTool.exe
IconIndex=0
`;
      const blob = new Blob([content], { type: 'text/plain' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'SnippingTool_Shortcut.url';
      a.click();
      setStatus('Downloaded SnippingTool_Shortcut.url — test opening it from Ctrl+J Downloads.');
    });

    // Original Portfolio Animations & Interactions
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const topbar = document.querySelector('.topbar');
    const cursor = document.querySelector('.cursor');
    const reveals = document.querySelectorAll('.reveal');
    const orb = document.querySelector('.orb');

    if ('IntersectionObserver' in window && !reduced) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) { entry.target.classList.add('in'); observer.unobserve(entry.target); }
        });
      }, { threshold: .14, rootMargin: '0px 0px -5% 0px' });
      reveals.forEach(el => observer.observe(el));
    } else { reveals.forEach(el => el.classList.add('in')); }

    let ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        topbar.classList.toggle('scrolled', window.scrollY > 80);
        if (orb && !reduced) orb.style.translate = `0 ${window.scrollY * .08}px`;
        ticking = false;
      });
    }
    addEventListener('scroll', onScroll, { passive:true }); onScroll();

    if (matchMedia('(pointer:fine)').matches) {
      addEventListener('pointermove', e => { cursor.style.left = `${e.clientX}px`; cursor.style.top = `${e.clientY}px`; });
      document.querySelectorAll('a,button,input,textarea,.project,.cap,.site-card,code').forEach(el => {
        el.addEventListener('pointerenter', () => cursor.classList.add('hot'));
        el.addEventListener('pointerleave', () => cursor.classList.remove('hot'));
      });
    }

    document.querySelectorAll('a[href^="#"]').forEach(link => link.addEventListener('click', e => {
      const target = document.querySelector(link.getAttribute('href'));
      if (target) { e.preventDefault(); target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth' }); }
    }));

    document.querySelectorAll('.project').forEach(project => project.addEventListener('click', () => {
      const note = document.querySelector('.project-note');
      note.textContent = 'Case-study links are ready to connect once verified project details are added.';
    }));

    document.getElementById('contactForm').addEventListener('submit', e => {
      e.preventDefault();
      const status = document.getElementById('formStatus');
      status.textContent = 'Message captured in this demo — connect a form endpoint to deliver it.';
      e.target.reset();
    });
    document.getElementById('year').textContent = new Date().getFullYear();
  </script>


