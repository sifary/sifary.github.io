      /* Compact launchpad controls and cards */
    #sites{--control-size:.65rem}
    #sites .action-btn,
    .carousel-tools :is(.carousel-count,.manage-btn,.carousel-nav button),
    #siteTrack :is(.screen-brand p,.panel-email,.panel-action){font-size:var(--control-size)}
    #launchpadCommand[hidden],#launchpadStatus[hidden]{display:none}
    #launchpadCommand{margin-bottom:0}
    #launchpadStatus{
      margin:.5rem 0 1rem;padding:0;border:0;border-radius:0;
      background:none;min-height:0;flex-wrap:wrap;gap:.35rem 1rem
    }
    .carousel-tools{display:grid;grid-template-columns:1fr auto 1fr;align-items:center}
    .carousel-tools > .quick-actions{justify-content:center;min-width:0}
    .carousel-tools > .carousel-actions{grid-column:3;justify-self:end;flex-wrap:nowrap}
    #siteTrack .device{height:auto;padding:8px;border-radius:18px}
    #siteTrack .device-top{height:36px;padding:0 2px 5px}
    #siteTrack .device-top i{flex:none}
    #siteTrack .device-url{
      flex:1;min-width:0;margin-left:.3rem;padding:.3rem .55rem;
      border:1px solid #d8dfeb;border-radius:7px;background:white;color:#394963;
      font-size:.8rem
    }
    #siteTrack .screen{height:auto}
    #siteTrack .screen-brand{height:clamp(142px,15vw,185px);padding:.8rem}
    #siteTrack .mark{width:42px;height:42px;margin:0 auto .55rem;border-radius:12px;font-size:1.1rem}
    #siteTrack .screen-brand p{margin:.35rem 0 0;opacity:.9}
    #siteTrack .screen-panel{
      display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;
      gap:.55rem;height:auto;min-height:48px;padding:.6rem .7rem
    }
    #siteTrack .panel-email{display:flex;min-width:0;white-space:nowrap;margin:0}
    #siteTrack .email-local{overflow:hidden;text-overflow:ellipsis;min-width:0}
    #siteTrack .email-domain{
      flex:0 0 auto;max-width:min(46%,11ch);overflow:hidden;
      mask-image:linear-gradient(to right,#000,transparent min(100%,11ch))
    }
    #siteTrack .panel-action{margin:0;white-space:nowrap}
    #siteTrack .agent-description{position:static;margin:0 .7rem;padding:.5rem 0;overflow-wrap:anywhere}
    .topbar{grid-template-columns:minmax(0,1fr) auto minmax(0,1fr)}
    .header-identity{display:flex;align-items:center;gap:clamp(.65rem,1.8vw,1.8rem)}
    .header-identity nav{display:flex;justify-content:space-evenly;gap:clamp(.5rem,1.4vw,1.35rem)}
    .topbar .timer-btn:is(.brand,.sync-import){
      display:inline-flex;align-items:center;font:700 .58rem var(--mono);padding:.45rem .65rem;
      text-transform:none;letter-spacing:normal
    }
    .topbar .sync-import::after{content:none}
    .topbar .timer-btn:focus-visible,.header-identity nav a:focus-visible{outline:2px solid var(--orange);outline-offset:3px}
    @media(max-width:1260px){
      .topbar{position:sticky;min-height:68px;height:auto;padding-block:.5rem;grid-template-columns:minmax(0,1fr) auto}
      .header-identity{grid-column:1/-1;grid-row:2;justify-content:center}
      .sync-control{grid-column:2;grid-row:1}
    }
    @media(max-width:900px){
      .topbar{position:sticky}
      .sync-control{flex-wrap:wrap;justify-content:flex-end;gap:.3rem}
      .carousel-tools{grid-template-columns:1fr auto;gap:.65rem}
      .carousel-tools > .carousel-actions{grid-column:2;grid-row:1}
      .carousel-tools > .quick-actions{grid-column:1/-1;grid-row:2}
    }
    @media(max-width:380px){
      html{scroll-padding-top:8rem}
      .topbar .sync-control{grid-row:3;grid-column:1/-1;justify-self:center}
      .topbar .header-timers{grid-column:1/-1;justify-content:center}
      .header-identity nav{font-size:.64rem}
    }

  </style>
