<body>
  <div class="noise" aria-hidden="true"></div>
  <div class="cursor" aria-hidden="true" style="left: 1107px; top: 546px;"></div>

  <header class="topbar scrolled">
    <div class="header-timers" aria-label="Case timers">
      <label class="header-preset">Preset
        <select id="headerTimerPreset" aria-label="Custom timer preset">
          <option value="30">0:30</option><option value="60">1:00</option><option value="90">1:30</option><option value="120">2:00</option><option value="150">2:30</option><option value="180" selected="">3:00</option><option value="210">3:30</option><option value="240">4:00</option><option value="270">4:30</option><option value="300">5:00</option>
        </select>
      </label>
      <button class="timer-btn" id="btn-timer-custom" type="button">Preset <span id="lbl-timer-custom">03:00</span></button>
      <button class="timer-btn" id="btn-timer-chat" type="button">Chat <span id="lbl-timer-chat">03:00</span></button>
      <button class="timer-btn" id="btn-timer-hold" type="button">Hold <span id="lbl-timer-hold">04:00</span></button>
    </div>
    <div class="header-identity">
      <a class="brand" href="#sites" aria-label="Home" aria-controls="launchpadCommand launchpadStatus" aria-expanded="false">AF<span>.</span></a>
      <nav aria-label="Primary navigation">
        <a href="#sites">Launchpad</a><a href="#about">About</a><a href="#work">Work</a><a href="#contact">Contact</a>
      </nav>
    </div>
    <div class="sync-control" title="Green: recently imported · Yellow: local changes · Red: import error">
      <span class="sync-dot" id="syncDot" aria-hidden="true"></span><span class="sync-label" id="syncLabel">Local changes</span>
      <button class="sync-import" id="importConfigBtn" type="button">Import workspace</button>
      <button class="sync-import" id="exportConfigBtn" type="button" title="Download your cards, clock and reference codes">Backup ↓</button>
      <input id="importConfigInput" type="file" accept="application/json,.json" hidden="">
    </div>
  </header>


  <main>
    <section class="section sites" id="sites">

      <div class="sites-head">
        <div class="sites-title">
          <div class="section-tag reveal in"><b>01</b> Shift Command &amp; Access Atlas</div>
          <div class="clock-meta-left reveal in">
            <span class="step-num">SYSTEM TIME</span><span class="clock-tz" id="clockTimezone">Asia/Singapore</span>
            <button class="btn-mini" id="clockSettingsBtn" type="button" aria-expanded="false">Style &amp; format</button>
            <button class="btn-mini" id="openManagerBtn" type="button">Manage carousel</button>
            <div class="clock-settings" id="clockSettings" aria-label="Clock style and format settings">
              <label>Typography<div class="clock-pills"><button class="clock-pill active" data-clock-style="digital" type="button">Digital</button><button class="clock-pill" data-clock-style="modern" type="button">Modern</button><button class="clock-pill" data-clock-style="classic" type="button">Classic</button></div></label>
              <label>Clock colour<div class="clock-swatches"><button class="clock-swatch active" data-clock-color="#a8c6ff" style="background:#a8c6ff" aria-label="Ice blue" type="button"></button><button class="clock-swatch" data-clock-color="#66ef9b" style="background:#66ef9b" aria-label="Mint" type="button"></button><button class="clock-swatch" data-clock-color="#67e8f9" style="background:#67e8f9" aria-label="Cyan" type="button"></button><button class="clock-swatch" data-clock-color="#ffbd59" style="background:#ffbd59" aria-label="Amber" type="button"></button><button class="clock-swatch" data-clock-color="#f8fafc" style="background:#f8fafc" aria-label="White" type="button"></button></div></label>
              <label>Day format<select id="clockDayFormat"><option value="short">Short (Mon)</option><option value="long">Full (Monday)</option></select></label>
              <label>Date format<select id="clockDateFormat"><option value="named">Nov 17, 2026</option><option value="dmy">17/11/2026</option><option value="mdy">11/17/2026</option><option value="iso">2026-11-17</option></select></label>
              <label>Time format<select id="clockTimeFormat"><option value="24">24-hour</option><option value="12">12-hour</option></select></label>
            </div>
          </div>
          <h2 class="reveal delay-1 in clock-digital" id="siteClockHeading" aria-live="off" style="--clock-color: #a8c6ff;"><span id="clockPrimary">02:46:09</span><br><span id="clockSecondary" style="-webkit-text-stroke-color: rgb(168, 198, 255);">Wed, 18 Nov 2026</span></h2>
        </div>
        <div style="margin: 0 auto"><p class="sites-intro reveal delay-2 in"><span class="section-kicker">Your operational desktop</span><strong>Agent Launchpad</strong>Choose a profile, then open a portal from the upper card panel. The lower panel copies its email and opens the portal; right-click to copy the email only. Use the controls below to manage cards, capture your screen or launch core shift tools.</p> <div class="scroll-cue">Scroll to explore <i>↓</i></div></div>
      </div>

      <!-- Profile Switcher & Instant Actions -->
      <div class="command-bar reveal in" id="launchpadCommand" hidden>
        <div class="profile-switcher" role="group" aria-label="Select Agent Profile">
          <span class="profile-label">Agent Profile:</span>
          <button type="button" class="profile-btn active" data-profile="amir"><i></i> Amir Faaiz</button>
          <button type="button" class="profile-btn" data-profile="yoca"><i></i> Yoca Alfarizi</button>
          <button type="button" class="profile-btn" data-profile="custom"><i></i> + Colleague</button>
        </div>

        <!-- Colleague Customizer Drawer -->
        <div class="custom-drawer" id="customDrawer">
          <div class="custom-field">
            <label for="custGoogle">Google (@support.fb.com)</label>
            <input type="text" id="custGoogle" placeholder="username@support.fb.com">
          </div>
          <div class="custom-field">
            <label for="custMs">Microsoft BMS (@apac.teleperformance.com)</label>
            <input type="text" id="custMs" placeholder="lastname.1@apac.teleperformance.com">
          </div>
          <div class="custom-field">
            <label for="custIce">IceWarp (@fb.teleperformance-my.com)</label>
            <input type="text" id="custIce" placeholder="first.last@fb.teleperformance-my.com">
          </div>
        </div>
      </div>

      <!-- Live Feedback / Clipboard Status Bar -->
      <div class="toast-bar reveal in" id="launchpadStatus" hidden role="status">
        <span id="statusMessage">Active Profile: Amir Faaiz — Click any card to auto-copy its email &amp; launch portal.</span>
        <span class="hint">Tip: Press <strong>Ctrl+V</strong> if a portal asks for your email a second time.</span>
      </div>


      <div class="carousel-tools reveal in">
        <span class="carousel-count"><span id="siteIndex">01</span> / <span id="siteTotal">05</span></span>
        <div class="quick-actions">
          <button type="button" class="action-btn" id="connectScreenBtn" title="Connect screen once to enable Spacebar screenshots without SnippingTool.exe">1. Connect Screen Capture</button>
          <button type="button" class="action-btn" id="snapClipBtn" title="Copy frame directly to clipboard (or press Spacebar)">2. Snap to Clipboard (Space)</button>
          <button type="button" class="action-btn primary" id="openAllShiftBtn" title="Open all 4 core shift tabs and copy Google email">Launch All Shift Tabs ↗</button>
        </div>
        <div class="carousel-actions"><button class="manage-btn" id="addCardBtn" type="button">Add card</button>
          <div class="carousel-nav"><button id="sitePrev" type="button" aria-label="Previous website">←</button><button id="siteNext" type="button" aria-label="Next website">→</button></div>
        </div>
      </div>
      <div class="site-track" id="siteTrack" tabindex="0" aria-label="Website carousel"></div>

      <!-- Workstation Screenshot & URI Protocol Helpers -->
      <div class="utility-grid reveal in">
        <div class="utility-box">
          <h4>Browser-Native Snipping Tool (Replaces Ctrl+N)</h4>
          <p>Avoid accidentally opening a new Chrome tab with <code>Ctrl+N</code>. Click <strong>1. Connect Screen Capture</strong> above, select your screen, and press <strong>Spacebar</strong> anytime on this tab to copy a crisp screenshot straight to your Windows clipboard.</p>
          <div class="utility-btns">
            <a class="action-btn" href="ms-screenclip:">Test URI: ms-screenclip:</a>
            <a class="action-btn" href="ms-snip:">Test URI: ms-snip:</a>
            <button type="button" class="action-btn" id="dlSnipUrlBtn">Download SnippingTool .URL</button>
          </div>
        </div>
        <div class="utility-box">
          <h4>Quick Email Clipboard Matrix (<span id="matrixOwner">Amir Faaiz</span>)</h4>
          <p>Need to paste an email mid-session without opening a new tab? One-click copy for your three core identities:</p>
          <div class="utility-btns">
            <button type="button" class="action-btn quick-copy-pill" data-key="google">Copy Google Email</button>
            <button type="button" class="action-btn quick-copy-pill" data-key="microsoft">Copy Microsoft (BMS)</button>
            <button type="button" class="action-btn quick-copy-pill" data-key="icewarp">Copy IceWarp Email</button>
          </div>
        </div>
      </div>


      <details class="code-vault reveal in">
        <summary><span>Reference sequence · click any code to edit</span><span class="code-vault-tools"><small>Editable · history and undo</small><button class="history-toggle" id="historyToggle" type="button" aria-label="Show edit history" title="Last five changes">↺</button><button class="reference-copy" id="copyReferenceBtn" type="button" aria-label="Copy all six reference codes">Copy all</button></span></summary>
        <div class="code-grid" id="referenceGrid" aria-label="Editable reference sequence">
          <code contenteditable="true" spellcheck="false" role="textbox" aria-label="Reference code 1">3200</code><code contenteditable="true" spellcheck="false" role="textbox" aria-label="Reference code 2">4837</code><code contenteditable="true" spellcheck="false" role="textbox" aria-label="Reference code 3">4959</code><code contenteditable="true" spellcheck="false" role="textbox" aria-label="Reference code 4">7073</code><code contenteditable="true" spellcheck="false" role="textbox" aria-label="Reference code 5">8522</code><code contenteditable="true" spellcheck="false" role="textbox" aria-label="Reference code 6">5482</code>
        </div>
        <div class="history-panel" id="historyPanel" aria-label="Reference sequence edit history"><p>No saved changes yet.</p></div>
      </details>
      <div class="save-flash" id="saveFlash" role="status">Changes saved. <button id="undoReference" type="button">Undo</button></div>

      <!-- Hidden video/canvas for native browser screenshot capture -->
      <video id="captureVideo" autoplay="" playsinline="" style="display:none"></video>
      <canvas id="captureCanvas" style="display:none"></canvas>
    </section>
    

    <div class="modal-backdrop" id="managerBackdrop" aria-hidden="true">
      <section class="manager-modal" role="dialog" aria-modal="true" aria-labelledby="managerTitle">
        <div class="modal-head"><h3 id="managerTitle">Carousel management</h3><button class="modal-close" id="managerClose" type="button" aria-label="Close">×</button></div>
        <div class="manager-layout">
          <aside class="card-roster"><div class="roster-head"><span class="step-num">CARDS</span><button class="primary-btn" id="modalAddCard" type="button">Add</button></div><div class="roster-list" id="cardRoster"></div></aside>
          <form class="card-form" id="cardForm">
            <h4 id="cardFormTitle">Add a carousel card</h4><input id="cardId" type="hidden">
            <label>Card name<input id="cardName" required="" maxlength="48"></label><label>Mark<input id="cardMark" required="" maxlength="3" placeholder="TP"></label>
            <label class="form-wide">Target URL<input id="cardUrl" type="url" required="" placeholder="https://example.com"></label>
            <label>Email username<input id="cardUsername" required="" autocomplete="off"></label><label>Email domain<input id="cardDomain" required="" placeholder="example.com"></label>
            <label class="form-wide">Brand subtitle<input id="cardSubtitle" maxlength="90" placeholder="What this portal is for"></label>
            <label class="form-wide">Agent description<textarea id="cardDescription" maxlength="220" placeholder="Optional note shown under the action panel"></textarea></label>
            <label class="form-wide">Brand background image<input id="cardImage" type="file" accept="image/png,image/jpeg,image/webp,image/gif"></label>
            <label class="check-row"><input id="cardOverlay" type="checkbox" checked=""> Show text overlay</label><label class="check-row"><input id="cardVisible" type="checkbox" checked=""> Display card</label>
            <p class="form-note" id="protectedNote"></p><div class="form-actions"><button class="secondary-btn" id="resetCardForm" type="button">Clear</button><button class="primary-btn" type="submit">Save card</button></div>
          </form>
        </div>
      </section>
    </div>
